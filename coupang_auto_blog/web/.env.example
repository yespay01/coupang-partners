# Automation Server URL (Docker 내부에서는 http://automation-server:4000)
AUTOMATION_SERVER_URL=http://localhost:4000

# Public site URL
NEXT_PUBLIC_SITE_URL=https://example.com

# Public API URL (브라우저에서 접근)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Coupang Partner ID used by the public dynamic banner (format: AF + digits)
# Keep this equal to settings.coupang.partnerId. Invalid or missing values hide the banner.
NEXT_PUBLIC_COUPANG_PARTNER_ID=

# iframe banner clicks bypass /go analytics. Keep OFF until a measured experiment is approved.
NEXT_PUBLIC_COUPANG_DYNAMIC_BANNER_ENABLED=false

# Admin route guard (set to true in non-production environments only)
ADMIN_GUARD_BYPASS=true
