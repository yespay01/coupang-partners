# ===========================
# Automation Server 환경변수
# ===========================

# 서버 설정
PORT=4000
NODE_ENV=development
API_BASE_URL=http://localhost:4000

# Database
DATABASE_URL=postgresql://coupang_user:your-password@localhost:5432/coupang_blog

# MinIO Storage
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123

# Coupang Partners API
COUPANG_ACCESS_KEY=your-access-key
COUPANG_SECRET_KEY=your-secret-key
COUPANG_PARTNER_ID=your-partner-id
COUPANG_SUB_ID=

# AI Providers
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=...

# JWT Auth
JWT_SECRET=your-jwt-secret
# 32바이트 이상의 독립 비밀값. 예: openssl rand -hex 32
# 미설정 시 안전한 JWT_SECRET을 fallback으로 사용하며,
# 둘 다 없으면 analytics ingest는 503으로 중단됩니다.
ANALYTICS_HASH_SECRET=
# 기본 OFF. true일 때만 04:20 KST에 최근 7일 rollup과 검토용 개선 후보를 생성합니다.
CTR_DAILY_DIAGNOSTICS_ENABLED=false
# 기본 OFF. true일 때만 목록형 API에서 놓친 상품을 Search API로 보완 관측합니다.
# 공식 Search 시간당 10회 한도 중 사용자 검색 여유를 남겨 매시간 최대 4개만 실행합니다.
PRICE_OBSERVATION_ENABLED=false
PRICE_OBSERVATION_DAILY_LIMIT=4
# 쿠팡이 반환한 차단 해제 ISO 시각. 비워두면 정상 호출하며, 시각 경과 후 자동 재개합니다.
COUPANG_SEARCH_BLOCKED_UNTIL=
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your-admin-password

# 네이버 검색 API (뉴스 생성 웹 검색용)
# 발급: https://developers.naver.com/apps/#/register → 검색 API 선택
NAVER_CLIENT_ID=your-naver-client-id
NAVER_CLIENT_SECRET=your-naver-client-secret

# Slack Webhook (선택)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# 이미지 서버
IMAGE_SERVER_URL=https://img.semolink.store

# 리뷰 설정
REVIEW_MAX_ATTEMPTS=3
